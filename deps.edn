{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/tools.logging {:mvn/version "1.3.0"}
        org.suskalo/coffi {:mvn/version "1.0.615"}
        insn/insn {:mvn/version "0.5.4"}
        ;; nREPL for live development - games start embedded nREPL server
        nrepl/nrepl {:mvn/version "1.3.0"}}

 :aliases
 {;; Development REPL with nREPL
  :dev
  {:extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-XstartOnFirstThread"
              "-Djava.library.path=libs:libs/macos:libs/linux_amd64:libs/win64_msvc16:/opt/homebrew/opt/raylib/lib:/opt/homebrew/lib:/usr/local/lib:/usr/lib"]
   :main-opts ["-m" "nrepl.cmdline" "--port" "9999"]}

  ;; Run examples - usage: clojure -M:hello-world
  ;; NOTE: Use 'clojure' not 'clj' - GUI apps don't work with rlwrap
  :hello-world
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-XstartOnFirstThread"
              "-Djava.library.path=libs:libs/macos:libs/linux_amd64:libs/win64_msvc16:/opt/homebrew/opt/raylib/lib:/opt/homebrew/lib:/usr/local/lib:/usr/lib"]
   :main-opts ["-m" "examples.hello-world"]}

  :pong
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-XstartOnFirstThread"
              "-Djava.library.path=libs:libs/macos:libs/linux_amd64:libs/win64_msvc16:/opt/homebrew/opt/raylib/lib:/opt/homebrew/lib:/usr/local/lib:/usr/lib"]
   :main-opts ["-m" "examples.pong"]}

  :asteroids
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-XstartOnFirstThread"
              "-Djava.library.path=libs:libs/macos:libs/linux_amd64:libs/win64_msvc16:/opt/homebrew/opt/raylib/lib:/opt/homebrew/lib:/usr/local/lib:/usr/lib"]
   :main-opts ["-m" "examples.asteroids"]}

  :asteroids2
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-XstartOnFirstThread"
              "-Djava.library.path=libs:libs/macos:libs/linux_amd64:libs/win64_msvc16:/opt/homebrew/opt/raylib/lib:/opt/homebrew/lib:/usr/local/lib:/usr/lib"]
   :main-opts ["-m" "examples.asteroids2"]}

  :tetris
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-XstartOnFirstThread"
              "-Djava.library.path=libs:libs/macos:libs/linux_amd64:libs/win64_msvc16:/opt/homebrew/opt/raylib/lib:/opt/homebrew/lib:/usr/local/lib:/usr/lib"]
   :main-opts ["-m" "examples.tetris"]}

  :vampire-survivors
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-XstartOnFirstThread"
              "-Djava.library.path=libs:libs/macos:libs/linux_amd64:libs/win64_msvc16:/opt/homebrew/opt/raylib/lib:/opt/homebrew/lib:/usr/local/lib:/usr/lib"]
   :main-opts ["-m" "examples.vampire-survivors"]}}}
