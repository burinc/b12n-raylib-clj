;; Configuration for the documentation site, read by the docs-engine
;; (https://github.com/b12n-oss/docs-engine).
;;
;; Build it locally from a docs-engine checkout:
;;   cd ~/dev/b12n-oss/docs-engine && bb serve ~/dev/b12n-oss/raylib-clj
;; CI builds it on every pull request from .github/workflows/site.yml, and
;; will publish from main once both the PUBLISH_SITE repository variable is
;; set to "true" and GitHub Pages is enabled, neither of which is done yet.
{;; :base-path is what makes this a project site rather than an org one.
 ;; The site is served at https://b12n-oss.github.io/raylib-clj/, so every
 ;; URL the engine emits needs that prefix. Leave it out and the pages
 ;; still render, but each one loads the ORGANIZATION site's stylesheet
 ;; and every asset 404s. The workflow has a check for exactly this.
 :base-path   "/raylib-clj"

 :title       "raylib-clj"
 :description "raylib game-development examples in Clojure, over coffi/Panama FFI."
 :asset-dirs  ["demos"]}
