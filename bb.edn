  ;; =============================================================================
  ;; 🔍 Code Quality
  ;; =============================================================================

  lint
  {:doc "🔍 Run clj-kondo linter"
   :task (do
           (h/header "🔍 Running clj-kondo Linter")
           (let [{:keys [exit]} (p/shell {:continue true} "clj-kondo" "--lint" "src")]
             (if (zero? exit)
               (h/success "No lint errors!")
               (System/exit exit))))}

  check
  {:doc "⭐ Fast checks (compile every namespace + lint) - use before committing"
   :task (do
           (h/header "🔍 Running Fast Checks")
           (h/step 1 "Compile check (every namespace under src/)...")
           (p/shell "clojure" "-M:check")
           (println)
           (h/step 2 "Lint check...")
           ;; clj-kondo exit codes: 0 clean, 2 warnings, 3 errors (verified).
           ;; The gate is ERRORS. There is a standing backlog of ~69 warnings,
           ;; nearly all `unused binding` in example code, and CONTRIBUTING.md
           ;; tells contributors the bar is "0 errors" - so failing on exit 2
           ;; made the documented gate unpassable and turned CI permanently red
           ;; on a known backlog. Warnings still print, and still show up in the
           ;; summary line, they just do not fail the build.
           (let [{:keys [exit]} (p/shell {:continue true} "clj-kondo" "--lint" "src")]
             (println)
             (cond
               (zero? exit) (h/success "All fast checks passed!")
               (= 2 exit)   (h/warn "Lint warnings found (see above) - not failing; the gate is errors")
               :else        (do (h/error-msg "Lint ERRORS found (see above)")
                                (System/exit exit)))))}

  docs-sync
  {:doc "Republish the docs: rebuild -> push site repo -> mirror to wiki -> S3 + CloudFront. Maintainer task (needs sibling repos, AWS_PROFILE=b12n). bb docs-sync [--no-push]"
   ;; Never force-pushes or auto-rebases: if a target is behind, it says so
   ;; and stops. --no-push commits locally and publishes nothing.
   ;;
   ;; Do NOT commit a docs/CNAME by hand. The b12n-docs engine writes it from
   ;; :cname, and `bb site:build` wipes the output dir first - a hand-placed
   ;; one survives a single build, then vanishes and takes the domain down.
   :task
   (let [push?     (not (some (fn [a] (= a "--no-push")) *command-line-args*))
         home      (System/getProperty "user.home")
         proj-dir  (System/getProperty "user.dir")
         docs-repo (str home "/dev/b12n-docs")
         site-repo (str home "/dev/b12n-raylib-clj.github.io")
         wiki-repo (str home "/dev/b12n-wikis")
         wiki-dir  (str wiki-repo "/b12n-raylib-clj")
         guide-dir (str proj-dir "/docs/guide")
         bucket    "b12n-site-raylib-clj"
         site-host "raylib-clj.b12n.app"
         hdr       (fn [label] (println (str "\n-- " label " --")))
         dirty?    (fn [dir path]
                     (let [res (shell {:dir dir :out :string} "git" "status" "--short" "--" path)]
                       (not (str/blank? (:out res)))))
         ;; Returns a keyword rather than exiting, so one repo's failure does not
         ;; block the other. `git add`/`git commit` are scoped to `path` - never
         ;; -A/. - because b12n-wikis is shared across many projects and a stray
         ;; staged file must not ride along.
         sync!     (fn [opts]
                     (let [label (:label opts) dir (:dir opts)
                           path (:path opts) msg (:msg opts)]
                       (hdr label)
                       (let [committed? (if (dirty? dir path)
                                          (do (shell {:dir dir} "git" "add" "--" path)
                                              (shell {:dir dir} "git" "commit" "-m" msg "--" path)
                                              true)
                                          false)]
                         (if-not push?
                           (do (println (if committed?
                                          "  committed locally (--no-push)"
                                          "  nothing to commit (--no-push)"))
                               :ok)
                           (do
                             (shell {:dir dir :continue true} "git" "fetch" "origin")
                             ;; One status read for every check, so a diverged branch cannot slip
                             ;; between them.
                             (let [st (:out (shell {:dir dir :out :string} "git" "status" "--short" "--branch"))]
                               (cond
                                 (str/includes? st "behind")
                                 (do (println (str "  BEHIND origin - resolve manually (cd " dir " && git pull --rebase), not auto-pushing"))
                                     :behind)

                                 ;; No upstream = no ahead/behind in the status line, so the "ahead"
                                 ;; check below would silently read as "nothing to push". filter-repo
                                 ;; drops the remote, which is how this repo landed here once.
                                 (not (str/includes? st "..."))
                                 (do (println (str "  NO UPSTREAM for main in " dir " - not pushing."))
                                     (println "  Fix with: git branch --set-upstream-to=origin/main main")
                                     :no-upstream)

                                 (not (str/includes? st "ahead"))
                                 (do (println "  up to date, nothing to push") :skipped)

                                 :else
                                 (let [pr (shell {:dir dir :continue true} "git" "push" "origin" "main")]
                                   (if (zero? (:exit pr))
                                     (do (println (if committed?
                                                    "  committed + pushed"
                                                    "  pushed (commit was already local)"))
                                         :ok)
                                     (do (println "  PUSH FAILED") :push-failed))))))))))
         ;; Publishes the BUILT site to the S3 origin behind CloudFront, then
         ;; invalidates the edge. Infra lives in ~/dev/b12n-infra
         ;; (resources/static-site/raylib-clj.edn); this skips with an explanation
         ;; if the aws CLI or the bucket is not there yet.
         ;;
         ;; The distribution id is looked up by alias, never hardcoded - tofu owns
         ;; it, and a stale id would invalidate someone else's site.
         deploy!   (fn []
                     (hdr "4/4 Deploy to S3 + CloudFront")
                     (cond
                       (not push?)
                       (do (println "  skipped (--no-push publishes nothing outward)") :deploy-disabled)

                       (not (fs/which "aws"))
                       (do (println "  DEPLOY SKIPPED - aws CLI not on PATH.") :aws-missing)

                       :else
                       (let [probe (shell {:continue true :out :string :err :string}
                                          "aws" "s3api" "head-bucket"
                                          "--bucket" bucket "--profile" "b12n")]
                         (if-not (zero? (:exit probe))
                           ;; head-bucket failing does NOT by itself mean the bucket is missing.
                           ;; It fails identically when the CLI cannot reach AWS at all - and on a
                           ;; restricted laptop HTTPS_PROXY is set, which the AWS CLI honours, so
                           ;; every call dies at the proxy while DNS and git keep working. Sending
                           ;; someone to tofu:apply for that means creating infrastructure that
                           ;; already exists. So classify the failure before advising anything.
                           (let [err   (str/lower-case (str (:err probe) " " (:out probe)))
                                 said  (first (str/split-lines (str/trim (str (:err probe) (:out probe)))))
                                 hit?  (fn [ss] (some (fn [s] (str/includes? err s)) ss))
                                 proxy (or (System/getenv "HTTPS_PROXY") (System/getenv "https_proxy"))]
                             (cond
                               (hit? ["proxy" "could not connect" "connect timeout" "endpoint url"
                                      "name resolution" "network is unreachable" "connection refused"
                                      "timed out" "connection was closed"])
                               (do (println "  DEPLOY SKIPPED - could not reach AWS at all.")
                                   (println (str "    " said))
                                   (println "  This is a network problem on THIS MACHINE. It is NOT evidence")
                                   (println "  about whether the bucket exists - do NOT run tofu:apply for it.")
                                   (when proxy
                                     (println (str "  HTTPS_PROXY is set (" proxy ") and the AWS CLI honours it.")))
                                   (println "  On a restricted laptop that proxy is the usual cause. Retry with:")
                                   (println "    unset HTTPS_PROXY HTTP_PROXY https_proxy http_proxy && bb docs-sync")
                                   :unreachable)

                               (hit? ["unable to locate credentials" "no credentials" "expiredtoken"
                                      "expired" "invalidclienttokenid" "signaturedoesnotmatch"
                                      "sso session" "token has expired"])
                               (do (println "  DEPLOY SKIPPED - AWS credentials for profile b12n are missing or expired.")
                                   (println (str "    " said))
                                   (println "  Refresh them and re-run. The infrastructure is unaffected.")
                                   :credentials)

                               (hit? ["403" "forbidden" "accessdenied"])
                               (do (println (str "  DEPLOY SKIPPED - s3://" bucket " EXISTS but profile b12n cannot read it (403)."))
                                   (println (str "    " said))
                                   (println "  That is a permissions problem, not missing infrastructure.")
                                   :forbidden)

                               (hit? ["404" "not found" "nosuchbucket"])
                               (do (println (str "  DEPLOY SKIPPED - s3://" bucket " does not exist."))
                                   (println "  THIS is the one that needs infrastructure. Run once in ~/dev/b12n-infra:")
                                   (println "    bb render lock tofu:init tofu:plan tofu:apply -- static-site raylib-clj")
                                   :missing-bucket)

                               :else
                               (do (println (str "  DEPLOY SKIPPED - head-bucket on s3://" bucket " failed for an unrecognized reason."))
                                   (println (str "    " said))
                                   (println "  Check by hand before assuming anything:")
                                   (println (str "    aws s3api head-bucket --bucket " bucket " --profile b12n"))
                                   :probe-failed)))
                           (let [sync-res (shell {:continue true}
                                                 "aws" "s3" "sync" (str site-repo "/docs/")
                                                 (str "s3://" bucket "/")
                                                 "--profile" "b12n" "--delete")]
                             (if-not (zero? (:exit sync-res))
                               (do (println "  S3 SYNC FAILED") :sync-failed)
                               (let [q (str "DistributionList.Items[?contains(Aliases.Items, `" site-host "`)].Id | [0]")
                                     dist (shell {:continue true :out :string}
                                                 "aws" "cloudfront" "list-distributions"
                                                 "--profile" "b12n" "--query" q "--output" "text")
                                     id (str/trim (or (:out dist) ""))]
                                 (if (or (str/blank? id) (= id "None"))
                                   (do (println (str "  synced, but no CloudFront distribution found for " site-host))
                                       (println "  (cache not invalidated - edge may serve stale files for a while)")
                                       :no-distribution)
                                   (let [inv (shell {:continue true}
                                                    "aws" "cloudfront" "create-invalidation"
                                                    "--profile" "b12n" "--distribution-id" id
                                                    "--paths" "/*")]
                                     (if (zero? (:exit inv))
                                       (do (println (str "  synced + invalidated (" id ") - https://" site-host)) :ok)
                                       (do (println "  synced, but INVALIDATION FAILED") :invalidation-failed)))))))))))]
     (hdr "1/4 Rebuild site")
     (let [res       (shell {:dir docs-repo :continue true} "bb" "site:build" "b12n-raylib-clj")
           build-ok? (zero? (:exit res))]
       (when-not build-ok? (println "  bb site:build FAILED"))
       (let [site-result (if build-ok?
                           (sync! {:label "2/4 b12n-raylib-clj.github.io" :dir site-repo :path "docs"
                                   :msg "chore: rebuild docs (bb docs-sync)"})
                           :build-failed)]
         (fs/create-dirs wiki-dir)
         (doseq [f (fs/glob guide-dir "*.md")]
           (fs/copy f (str wiki-dir "/" (fs/file-name f)) {:replace-existing true}))
         (let [wiki-result (sync! {:label "3/4 b12n-wikis" :dir wiki-repo :path "b12n-raylib-clj"
                                   :msg "b12n-raylib-clj: mirror docs/guide (bb docs-sync)"})
               deploy-result (deploy!)]
           (hdr "Summary")
           (println (str "  site:   " site-result))
           (println (str "  wiki:   " wiki-result))
           (println (str "  deploy: " deploy-result))
           ;; Allowlist, not denylist. The successes are :ok, :skipped (sync!'s
           ;; "up to date, nothing to push") and :deploy-disabled (--no-push).
           ;; Everything else exits non-zero. Stated as an allowlist so a failure
           ;; mode added later fails loudly by default instead of slipping through
           ;; as a silent success - which is exactly how a skipped deploy exited 0.
           (when-not (every? (fn [r] (contains? #{:ok :skipped :deploy-disabled} r))
                             [site-result wiki-result deploy-result])
             (System/exit 1))))))}

  check:full
  {:doc "🔍 Comprehensive checks (compile + lint + LSP)"
   :task (do
           (h/header "🔍 Running Comprehensive Checks")
           (h/step 1 "Checking compilation...")
           (p/shell "clj" "-M" "-e" "(require 'examples.asteroids)")
           (println)
           (h/step 2 "Running clj-kondo lint...")
           (let [{:keys [exit]} (p/shell {:continue true} "clj-kondo" "--lint" "src")]
             (when-not (zero? exit)
               (h/warn "Lint warnings found")))
           (println)
           (h/step 3 "Checking code formatting...")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "format" "--dry"
                                         "--project-root" (str (fs/cwd)))]
             (when-not (zero? exit)
               (h/warn "Formatting issues found")
               (h/info "Run 'bb lsp:format' to fix")))
           (println)
           (h/step 4 "Checking namespace forms...")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "clean-ns" "--dry"
                                         "--project-root" (str (fs/cwd)))]
             (when-not (zero? exit)
               (h/warn "Namespace issues found")
               (h/info "Run 'bb lsp:clean-ns' to fix")))
           (println)
           (h/success "All comprehensive checks complete!")
           (h/info "Fix issues with 'bb lsp:fix' if needed"))}

