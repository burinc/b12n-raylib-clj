{:min-bb-version "1.3.0"

 :tasks
 {:requires ([babashka.process :as p]
             [babashka.fs :as fs]
             [clojure.string :as str])

  :init
  (do
    (def bold "\033[1m")
    (def green "\033[0;32m")
    (def yellow "\033[1;33m")
    (def red "\033[0;31m")
    (def cyan "\033[0;36m")
    (def magenta "\033[0;35m")
    (def reset "\033[0m")

    (defn color [c text] (str c text reset))
    (defn step [n text] (println (color yellow (str "Step " n ":")) text))
    (defn success [text] (println (color green (str "✅ " text))))
    (defn error-msg [text] (println (color red (str "❌ " text))))
    (defn info [text] (println (color cyan (str "ℹ️  " text))))
    (defn warn [text] (println (color yellow (str "⚠️  " text))))
    (defn header [text]
      (println)
      (println (color bold text))
      (println (apply str (repeat (count text) "=")))))

  ;; =============================================================================
  ;; 🎮 Game Examples - Run with: bb <game-name>
  ;; =============================================================================

  ;; NOTE: Use 'clojure' not 'clj' - GUI apps don't work with rlwrap
  hello-world
  {:doc "🎮 Run Hello World example (basic window test)"
   :task (do
           (header "🎮 Running Hello World")
           (info "Basic window with text - good for testing setup")
           (p/shell "clojure" "-M:hello-world"))}

