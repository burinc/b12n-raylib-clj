  ;; =============================================================================
  ;; 🔧 Development
  ;; =============================================================================

  repl
  {:doc "🔧 Start Clojure REPL for interactive development"
   :override-builtin true
   :task (do
           (h/header "🔧 Starting Clojure REPL")
           (h/info "Use (require '[examples.asteroids :as game]) then (game/-main)")
           (p/shell "clj"))}

  nrepl
  {:doc "🔧 Start nREPL server on port 7999 (for non-GUI work)"
   :task (do
           (h/header "🔧 Starting nREPL Server")
           (h/info "nREPL listening on port 7999 (standalone, non-GUI work)")
           (h/info "For live game dev: run a game first, connect to port 7888")
           (p/shell "clojure" "-M:dev"))}

  ;; =============================================================================
  ;; 🔍 Code Quality
  ;; =============================================================================

  lint
  {:doc "🔍 Run clj-kondo linter"
   :task (do
           (h/header "🔍 Running clj-kondo Linter")
           (let [{:keys [exit]} (p/shell {:continue true} "clj-kondo" "--lint" "src")]
             (if (zero? exit)
               (h/success "No lint errors!")
               (System/exit exit))))}

  check
  {:doc "⭐ Fast checks (compile + lint) - use before committing"
   :task (do
           (h/header "🔍 Running Fast Checks")
           (h/step 1 "Compile check...")
           (p/shell "clj" "-M" "-e" "(require 'examples.asteroids)")
           (println)
           (h/step 2 "Lint check...")
           (let [{:keys [exit]} (p/shell {:continue true} "clj-kondo" "--lint" "src")]
             (println)
             (if (zero? exit)
               (h/success "All fast checks passed!")
               (do
                 (h/warn "Lint warnings found (see above)")
                 (System/exit exit)))))}

  check:full
  {:doc "🔍 Comprehensive checks (compile + lint + LSP)"
   :task (do
           (h/header "🔍 Running Comprehensive Checks")
           (h/step 1 "Checking compilation...")
           (p/shell "clj" "-M" "-e" "(require 'examples.asteroids)")
           (println)
           (h/step 2 "Running clj-kondo lint...")
           (let [{:keys [exit]} (p/shell {:continue true} "clj-kondo" "--lint" "src")]
             (when-not (zero? exit)
               (h/warn "Lint warnings found")))
           (println)
           (h/step 3 "Checking code formatting...")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "format" "--dry"
                                         "--project-root" (str (fs/cwd)))]
             (when-not (zero? exit)
               (h/warn "Formatting issues found")
               (h/info "Run 'bb lsp:format' to fix")))
           (println)
           (h/step 4 "Checking namespace forms...")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "clean-ns" "--dry"
                                         "--project-root" (str (fs/cwd)))]
             (when-not (zero? exit)
               (h/warn "Namespace issues found")
               (h/info "Run 'bb lsp:clean-ns' to fix")))
           (println)
           (h/success "All comprehensive checks complete!")
           (h/info "Fix issues with 'bb lsp:fix' if needed"))}

  ;; =============================================================================
  ;; 🎨 LSP Tasks
  ;; =============================================================================

  lsp:format
  {:doc "🎨 Format all Clojure files"
   :task (do
           (h/header "🎨 Formatting Code")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "format"
                                         "--project-root" (str (fs/cwd)))]
             (if (zero? exit)
               (h/success "Code formatted!")
               (do
                 (h/error-msg "Formatting failed")
                 (System/exit exit)))))}

  lsp:format-check
  {:doc "🎨 Check formatting (dry run)"
   :task (do
           (h/header "🔍 Checking Code Formatting")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "format" "--dry"
                                         "--project-root" (str (fs/cwd)))]
             (if (zero? exit)
               (h/success "All files properly formatted!")
               (do
                 (h/warn "Files need formatting (see diff above)")
                 (h/info "Run 'bb lsp:format' to fix")
                 (System/exit 1)))))}

  lsp:clean-ns
  {:doc "🧹 Clean and organize ns forms"
   :task (do
           (h/header "🧹 Cleaning Namespace Forms")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "clean-ns"
                                         "--project-root" (str (fs/cwd)))]
             (if (zero? exit)
               (h/success "Namespaces cleaned!")
               (do
                 (h/error-msg "clean-ns failed")
                 (System/exit exit)))))}

  lsp:clean-ns-check
  {:doc "🧹 Check ns forms (dry run)"
   :task (do
           (h/header "🔍 Checking Namespace Forms")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "clean-ns" "--dry"
                                         "--project-root" (str (fs/cwd)))]
             (if (zero? exit)
               (h/success "All namespace forms are clean!")
               (do
                 (h/warn "Namespaces need cleaning (see diff above)")
                 (h/info "Run 'bb lsp:clean-ns' to fix")
                 (System/exit exit)))))}

  lsp:diagnostics
  {:doc "🔬 Run clojure-lsp diagnostics"
   :task (do
           (h/header "🔬 Running LSP Diagnostics")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "diagnostics"
                                         "--project-root" (str (fs/cwd)))]
             (if (zero? exit)
               (h/success "No diagnostics found!")
               (do
                 (h/warn "Diagnostics found (see above)")
                 (System/exit exit)))))}

  lsp:check
  {:doc "🔍 All LSP checks (format + clean-ns + diagnostics)"
   :task (do
           (h/header "🔍 Running All LSP Checks")
           (h/step 1 "Checking code formatting...")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "format" "--dry"
                                         "--project-root" (str (fs/cwd)))]
             (when-not (zero? exit)
               (h/warn "Formatting issues found")
               (h/info "Run 'bb lsp:format' to fix")))
           (println)
           (h/step 2 "Checking namespace forms...")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "clean-ns" "--dry"
                                         "--project-root" (str (fs/cwd)))]
             (when-not (zero? exit)
               (h/warn "Namespace issues found")
               (h/info "Run 'bb lsp:clean-ns' to fix")))
           (println)
           (h/step 3 "Running diagnostics...")
           (let [{:keys [exit]} (p/shell {:continue true}
                                         "clojure-lsp" "diagnostics"
                                         "--project-root" (str (fs/cwd)))]
             (if (zero? exit)
               (h/success "All LSP checks passed!")
               (do
                 (h/warn "Some issues found (see above)")
                 (System/exit 1)))))}

  lsp:fix
  {:doc "🔧 Auto-fix format + clean-ns"
   :task (do
           (h/header "🔧 Fixing Code with LSP")
           (h/step 1 "Formatting code...")
           (p/shell {:continue true}
                    "clojure-lsp" "format"
                    "--project-root" (str (fs/cwd)))
           (println)
           (h/step 2 "Cleaning namespaces...")
           (p/shell {:continue true}
                    "clojure-lsp" "clean-ns"
                    "--project-root" (str (fs/cwd)))
           (println)
           (h/success "All auto-fixes applied!")
           (h/info "Run 'bb lsp:diagnostics' to check remaining issues"))}

  ;; =============================================================================
  ;; 🪝 Git Hooks
  ;; =============================================================================

  hooks:install
  {:doc "🪝 Install git pre-commit hook (lint only)"
   :task (do
           (h/header "🪝 Installing Git Pre-commit Hook")
           (let [hook-path ".git/hooks/pre-commit"
                 hook-content "#!/bin/bash
# raylib-clojure-playground pre-commit hook (fast - lint only)
set -e
echo \"🔍 Running pre-commit lint check...\"
clj-kondo --lint src
echo \"✅ Lint check passed!\"
"]
             (spit hook-path hook-content)
             (p/shell "chmod" "+x" hook-path)
             (h/success "Pre-commit hook installed (lint only)")
             (h/info "Hook will run automatically on 'git commit'")
             (h/info "To skip: git commit --no-verify")))}

  hooks:uninstall
  {:doc "🪝 Remove git pre-commit hook"
   :task (let [hook-path ".git/hooks/pre-commit"]
           (if (fs/exists? hook-path)
             (do
               (fs/delete hook-path)
               (h/success "Pre-commit hook removed!"))
             (h/info "No pre-commit hook found")))}

  ;; =============================================================================
  ;; 📦 Dependencies & Build
  ;; =============================================================================

  clean
  {:doc "🧹 Clean build artifacts"
   :task (do
           (h/header "🧹 Cleaning Build Artifacts")
           (doseq [dir ["target" ".cpcache" "classes"]]
             (when (fs/exists? dir)
               (fs/delete-tree dir)
               (println (str "  Removed " dir))))
           (h/success "Cleaned!"))}

  deps
  {:doc "📦 Download and cache dependencies"
   :task (do
           (h/header "📦 Downloading Dependencies")
           (p/shell "clj" "-P")
           (p/shell "clj" "-P" "-M:dev")
           (h/success "Dependencies cached!"))}

  deps:tree
  {:doc "📦 Show dependency tree"
   :task (do
           (h/header "📦 Dependency Tree")
           (p/shell "clj" "-Stree"))}

  outdated
  {:doc "📦 Check for outdated dependencies"
   :task (do
           (h/header "🔍 Checking Outdated Dependencies")
           (p/shell {:continue true}
                    "clj" "-Sdeps"
                    "{:deps {com.github.liquidz/antq {:mvn/version \"RELEASE\"}}}"
                    "-M" "-m" "antq.core"))}

  ;; =============================================================================
  ;; 📊 Utilities
  ;; =============================================================================

  loc
  {:doc "📊 Count lines of code"
   :task (let [clj-files (fs/glob "src" "**/*.clj")
               lines (map (fn [f] (count (str/split-lines (slurp (str f))))) clj-files)
               total (reduce + 0 lines)]
           (h/header "📊 Lines of Code")
           (println (str "  Total lines: " (h/color h/green (str total))))
           (println (str "  Files: " (h/color h/cyan (str (count clj-files))))))}

  tree
  {:doc "📁 Show project structure"
   :task (do
           (h/header "📁 Project Structure")
           (p/shell "tree" "-I" "target|.git|.cpcache|classes" "-L" "3"))}

  ;; =============================================================================
  ;; 🍎 macOS Specific
  ;; =============================================================================

  macos:sign-lib
  {:doc "🍎 Sign raylib library for macOS"
   :task (do
           (h/header "🍎 Signing Raylib Library for macOS")
           (let [lib-path "libs/macos/libraylib.5.5.0.dylib"]
             (if (fs/exists? lib-path)
               (do
                 (p/shell "codesign" "--force" "--sign" "-" lib-path)
                 (h/success (str "Signed: " lib-path)))
               (h/error-msg (str "Library not found: " lib-path)))))}

