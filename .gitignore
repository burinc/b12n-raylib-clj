# Leiningen
target/
pom.xml
pom.xml.asc
.lein-*

# Clojure
.nrepl-port
.cpcache/
*.jar
*.class

# IDE
.idea/
*.iml

# clj-kondo's analysis cache. The config and the coffi/defcfn hook next to it
# ARE tracked — they're what makes `bb lint` usable (without the hook the suite
# reports 776 false positives).
.clj-kondo/.cache/

# clj-kondo configs clojure-lsp auto-imports from whatever's on its resolved
# classpath — unrelated to this project's own config.
.clj-kondo/imports/

# clojure-lsp's analysis cache, created by `bb lsp:*`
.lsp/.cache/
.lsp/sqlite.db

# storage.data is written by the storage-values example at runtime
storage.data

# OS
.DS_Store

# screen-grab teardown markers (out-dir scratch; recover-pending! executes these)
docs/demos/.screen-grab-pending.edn*
